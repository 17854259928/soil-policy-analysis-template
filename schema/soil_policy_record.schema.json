{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/soil-policy-record.v1.json",
  "title": "Soil Policy Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "source_language", "document_type", "soil_relevance", "soil_objectives", "policy_instruments", "evidence", "warnings"],
  "properties": {
    "source_id": {"type": "string"},
    "source_language": {"type": "string", "default": "und"},
    "document_type": {"type": "string", "enum": ["legal_act", "strategy", "programme", "intervention", "implementation_report", "evaluation", "monitoring_report", "other"]},
    "policy_name": {"type": ["string", "null"]},
    "legal_identifier": {"type": ["string", "null"]},
    "jurisdiction": {"type": ["string", "null"]},
    "responsible_authority": {"type": ["string", "null"]},
    "parent_programme": {"type": ["string", "null"]},
    "adoption_date": {"type": ["string", "null"]},
    "effective_date": {"type": ["string", "null"]},
    "implementation_start": {"type": ["string", "null"]},
    "implementation_end": {"type": ["string", "null"]},
    "soil_relevance": {"type": "string", "enum": ["DIRECT", "EXPLICIT_MECHANISM", "CO_BENEFIT_ONLY", "NOT_DEMONSTRATED"]},
    "soil_objectives": {"type": "array", "items": {"$ref": "#/$defs/codedLabel"}},
    "policy_instruments": {"type": "array", "items": {"$ref": "#/$defs/codedLabel"}},
    "soil_threats": {"type": "array", "items": {"type": "string"}},
    "management_practices": {"type": "array", "items": {"type": "string"}},
    "target_actors": {"type": "array", "items": {"type": "string"}},
    "target_land_uses": {"type": "array", "items": {"type": "string"}},
    "target_farming_systems": {"type": "array", "items": {"type": "string"}},
    "geographic_scope": {"type": "array", "items": {"type": "string"}},
    "budget_amount": {"type": ["number", "null"]},
    "currency": {"type": ["string", "null"]},
    "budget_period": {"type": ["string", "null"]},
    "funding_sources": {"type": "array", "items": {"type": "string"}},
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/quantifiedItem"}},
    "soil_indicators": {"type": "array", "items": {"$ref": "#/$defs/soilIndicator"}},
    "planned_targets": {"type": "array", "items": {"$ref": "#/$defs/quantifiedItem"}},
    "reported_outputs": {"type": "array", "items": {"$ref": "#/$defs/quantifiedItem"}},
    "reported_outcomes": {"type": "array", "items": {"$ref": "#/$defs/soilIndicator"}},
    "co_benefits_trade_offs": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "codedLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "confidence", "evidence_text"],
      "properties": {
        "code": {"type": "string"},
        "status": {"type": "string", "enum": ["present", "absent", "uncertain", "not_observable"]},
        "bindingness": {"type": "string", "enum": ["binding", "conditional", "voluntary", "informational", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_text": {"type": ["string", "null"]},
        "locator": {"type": ["string", "null"]}
      }
    },
    "quantifiedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator", "value", "unit", "temporality", "evidence_text"],
      "properties": {
        "indicator": {"type": "string"},
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": ["string", "null"]},
        "temporality": {"type": "string", "enum": ["planned", "implemented", "reported_output", "reported_outcome", "unknown"]},
        "year_or_period": {"type": ["string", "null"]},
        "evidence_text": {"type": "string"},
        "locator": {"type": ["string", "null"]}
      }
    },
    "soilIndicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator", "value", "unit", "status", "evidence_text"],
      "properties": {
        "indicator": {"type": "string"},
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["baseline", "target", "measured", "modelled", "expected", "unknown"]},
        "direction": {"type": "string", "enum": ["increase", "decrease", "maintain", "other", "unknown"]},
        "baseline_year": {"type": ["string", "null"]},
        "target_or_observation_year": {"type": ["string", "null"]},
        "soil_depth": {"type": ["string", "null"]},
        "sampling_basis": {"type": ["string", "null"]},
        "spatial_scale": {"type": ["string", "null"]},
        "measurement_method": {"type": ["string", "null"]},
        "evidence_text": {"type": "string"},
        "locator": {"type": ["string", "null"]}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "statement", "causal_status", "evidence_text"],
      "properties": {
        "category": {"type": "string", "enum": ["ghg", "water", "biodiversity", "production", "farm_cost", "income", "food_security", "distribution", "other"]},
        "statement": {"type": "string"},
        "causal_status": {"type": "string", "enum": ["explicit", "expected", "reported", "modelled", "inferred"]},
        "evidence_text": {"type": "string"},
        "locator": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_name", "evidence_text"],
      "properties": {
        "field_name": {"type": "string"},
        "evidence_text": {"type": "string"},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": ["string", "null"]},
        "table_or_row": {"type": ["string", "null"]}
      }
    }
  }
}
